---
// The VisaRadar mark: two range rings, a sweep and one amber "invited" blip. Colours come from tokens.
interface Props {
  size?: number;
  /** Unique per page, so two marks don't share a gradient id. */
  id: string;
  class?: string;
}
const { size = 28, id, class: cls } = Astro.props;
const g = `vr-sweep-${id}`;
---
<svg class:list={['vr-logo', cls]} aria-hidden="true" width={size} height={size} viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id={g} gradientUnits="userSpaceOnUse" x1="27" y1="6" x2="52" y2="16">
      <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0" />
      <stop offset="1" style="stop-color: var(--accent); stop-opacity: 0.55" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="27" style="stroke: var(--accent)" stroke-width="4.5" />
  <circle cx="32" cy="32" r="15" style="stroke: var(--accent)" stroke-width="3.5" stroke-opacity="0.55" />
  <path d="M32 32 L27.31 5.41 A27 27 0 0 1 52.68 14.64 Z" fill={`url(#${g})`} />
  <path d="M32 32 L52.68 14.64" style="stroke: var(--accent)" stroke-width="4" stroke-linecap="round" />
  <circle cx="39.1" cy="14.4" r="5" style="fill: var(--invite)" />
  <circle cx="32" cy="32" r="4.5" style="fill: var(--accent)" />
</svg>
