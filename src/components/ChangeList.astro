---
import type { Change } from '../lib/data/types';
import { formatDate } from '../lib/format';
import { NEWS_SOURCES } from '../lib/official';

interface Props { items: Change[] }
const KIND: Record<string, string> = {
  news: 'News',
  'eoi-month': 'EOI data',
  'state-status': 'State program',
  round: 'Round',
  allocation: 'Allocation',
};
// Sources that aren't news sites.
const OTHER: Record<string, string> = { skillselect: 'SkillSelect' };
const { items } = Astro.props;
---
<ul class="news-list">
  {items.map((c) => (
    <li>
      <span class="meta"><span class="badge plain">{KIND[c.kind] ?? c.kind}</span><time datetime={c.at}>{formatDate(c.at)}</time><span>{NEWS_SOURCES[c.source]?.label ?? OTHER[c.source] ?? c.source}</span></span>
      <a class="title" href={c.url} rel="noopener">{c.title}</a>
    </li>
  ))}
</ul>
