---
import type { NewsItem } from '../lib/data/types';
import { NEWS_SOURCES, TAG_LABELS } from '../lib/official';
import { formatDate } from '../lib/format';
import { excerptToShow, monogram } from '../lib/news';

interface Props { items: NewsItem[] }
const { items } = Astro.props;
---
<ul class="news-list">
  {items.map((n) => (
    <li>
      <span class="meta">
        <span class="mono" aria-hidden="true" title={NEWS_SOURCES[n.source]?.label ?? n.source}>{monogram(n.source)}</span>
        <span class="visually-hidden">{NEWS_SOURCES[n.source]?.label ?? n.source}.</span>
        {n.published ? <time datetime={n.published}>{formatDate(n.published)}</time> : <span>First seen {formatDate(n.firstSeen)}</span>}
        {(n.tags ?? []).map((t) => <span class="chip">{TAG_LABELS[t] ?? t}</span>)}
      </span>
      <a class="title" href={n.url} rel="noopener">{n.title}</a>
      {excerptToShow(n.title, n.excerpt) && <p class="excerpt">{excerptToShow(n.title, n.excerpt)}</p>}
    </li>
  ))}
</ul>
