---
import '../styles/global.css';
import { site } from '../site.config';
import { href } from '../lib/href';
import { getMeta } from '../lib/data/eoi';
import { formatMonth } from '../lib/format';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description?: string;
  /** Extra RSS feed for this page, in addition to the site-wide ones. */
  feed?: { title: string; path: string };
}
const { title, description = site.tagline, feed } = Astro.props;
const pageTitle = title === site.name ? `${site.name}: ${site.tagline}` : `${title} · ${site.name}`;
const meta = getMeta();
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
// `tab` puts an item in the bottom bar on phones; the rest stay in the header.
const nav = [
  { path: '/states/', label: 'States', tab: 'States', icon: 'M3 6.5 9 4.5l6 2 6-2v13l-6 2-6-2-6 2z M9 4.5v13 M15 6.5v13' },
  { path: '/occupations/', label: 'Occupations', tab: 'Jobs', icon: 'M4 8h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z M9 8V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V8 M3 13.5h18' },
  { path: '/news/', label: 'News', tab: 'News', icon: 'M5 4h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z M8 9h8 M8 13h8 M8 17h5' },
  { path: '/rounds/', label: 'Rounds', tab: 'Rounds', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z M12 11.2a.8.8 0 1 0 0 1.6.8.8 0 0 0 0-1.6z' },
  { path: '/pathways/', label: 'Pathways' },
  { path: '/eoi-check/', label: 'Was I invited?' },
  { path: '/me/', label: 'Where I stand', tab: 'Me', icon: 'M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M4.5 20.5a7.5 7.5 0 0 1 15 0' },
];
const ogImage = new URL(href('/og-image.png'), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = (p: string) => path === p || path.startsWith(p);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: mark returning visitors so the home page can skip the setup form.
      try { if (localStorage.getItem('visaradar.profile.v1')) document.documentElement.classList.add('has-profile'); } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} logo: a radar sweep with one highlighted point. ${site.tagline}`} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} news`} href={href('/news.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: what changed`} href={href('/changes.xml')} />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={href(feed.path)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('/')} aria-label={`${site.name} home`}>
          <Logo id="head" size={30} />
          <span class="wordmark">Visa<span>Radar</span></span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li class:list={{ 'has-tab': !!n.tab }}><a href={href(n.path)} aria-current={current(n.path) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <nav class="tabbar" aria-label="Sections">
      <ul>
        {nav.filter((n) => n.tab).map((n) => (
          <li>
            <a href={href(n.path)} aria-current={current(n.path) ? 'page' : undefined}>
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={n.icon} /></svg>
              <span>{n.tab}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <footer class="site-footer">
      <div class="wrap">
        <a class="brand foot-brand" href={href('/')} aria-label={`${site.name} home`}>
          <Logo id="foot" size={26} />
          <span class="wordmark">Visa<span>Radar</span></span>
        </a>
        <p class="disclaimer"><strong>{site.disclaimer}</strong></p>
        <p class="small">
          EOI figures: SkillSelect, as at {meta.latestMonth ? formatMonth(meta.latestMonth) : 'not yet loaded'} (month-end snapshot).
          {site.name} is independent and not a government site. No accounts, no ads, no tracking.
        </p>
        <ul class="plain foot-links small">
          <li><a href={href('/about/')}>Sources and method</a></li>
          <li><a href={href('/datasets/')}>Home Affairs datasets</a></li>
          <li><a href={href('/news.xml')}>News RSS</a></li>
          <li><a href={href('/changes.xml')}>Changes RSS</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // Whole table rows with a link are clickable, without breaking links, text selection or keyboard use.
      document.addEventListener('click', (e) => {
        const t = e.target instanceof Element ? e.target : null;
        const tr = t?.closest('tr.rowlink');
        if (!tr || t?.closest('a, button, input, select') || window.getSelection()?.toString()) return;
        tr.querySelector('a')?.click();
      });
      // Print the chart and map tables open, then put them back as they were.
      let opened: HTMLDetailsElement[] = [];
      addEventListener('beforeprint', () => {
        opened = [...document.querySelectorAll<HTMLDetailsElement>('details.vr-table:not([open])')];
        opened.forEach((d) => (d.open = true));
      });
      addEventListener('afterprint', () => opened.forEach((d) => (d.open = false)));
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-card) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px); -webkit-backdrop-filter: saturate(1.4) blur(8px);
  }
  .bar { display: flex; align-items: center; gap: var(--s-2) var(--s-5); padding-block: var(--s-2); }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 750; color: var(--ink); text-decoration: none; letter-spacing: -0.02em; font-size: var(--text-lg); min-height: 2.75rem; }
  .brand:hover { color: var(--ink); text-decoration: none; }
  .wordmark > span { color: var(--accent); }
  nav[aria-label='Main'] { margin-left: auto; }
  nav ul { list-style: none; display: flex; gap: var(--s-1); margin: 0; padding: 0; }
  nav[aria-label='Main'] a { display: flex; align-items: center; min-height: 2.75rem; padding: 0 var(--s-3); border-radius: 999px; color: var(--ink-2); text-decoration: none; font-size: var(--text-sm); font-weight: 600; white-space: nowrap; }
  nav[aria-label='Main'] a:hover { background: var(--surface-sunk); color: var(--ink); }
  nav[aria-label='Main'] a[aria-current='page'] { color: var(--accent-strong); background: var(--accent-soft); }
  /* Phones: the main sections move to a bottom bar within thumb reach; the header keeps the rest. */
  @media (max-width: 47.99rem) { nav[aria-label='Main'] li.has-tab { display: none; } }
  .tabbar {
    position: fixed; inset: auto 0 0 0; z-index: 20; border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface-card) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(8px); -webkit-backdrop-filter: saturate(1.4) blur(8px);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .tabbar ul { justify-content: space-around; max-width: 32rem; margin: 0 auto; }
  .tabbar li { flex: 1 1 0; }
  .tabbar a { display: grid; justify-items: center; gap: 2px; min-height: 3.5rem; padding: var(--s-2) var(--s-1) var(--s-1); color: var(--ink-3); text-decoration: none; font-size: var(--text-xs); font-weight: 600; }
  .tabbar a:hover { color: var(--ink); }
  .tabbar a[aria-current='page'] { color: var(--accent-strong); }
  .tabbar a[aria-current='page'] svg { background: var(--accent-soft); border-radius: 999px; box-sizing: content-box; padding: 2px 12px; margin-block: -2px; }
  @media (min-width: 48rem) { .tabbar { display: none; } }
  @media (max-width: 47.99rem) { :global(body) { padding-bottom: calc(3.75rem + env(safe-area-inset-bottom)); } }
  /* clip, not hidden: full-bleed bands can't cause sideways scroll, and sticky still works. */
  main { padding-block: var(--s-5) var(--s-7); overflow-x: clip; }
  @media (min-width: 48rem) { main { padding-block: var(--s-6) var(--s-8); } }
  .site-footer { border-top: 1px solid var(--line); background: var(--surface-card); padding-block: var(--s-6); color: var(--ink-2); }
  .foot-brand { margin-bottom: var(--s-3); font-size: var(--text-md); }
  .disclaimer { color: var(--ink); }
  .foot-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
</style>
